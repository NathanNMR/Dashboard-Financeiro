# MySQL
DB_HOST=seu-host-mysql
DB_PORT=3306
DB_NAME=smartfinance
DB_USER=seu-usuario
DB_PASSWORD=sua-senha

# Autenticação
# No Render Blueprint, JWT_SECRET pode ser gerado automaticamente.
JWT_SECRET=troque-por-uma-chave-com-pelo-menos-32-caracteres
JWT_TTL_SECONDS=86400

# Frontend autorizado a consumir a API.
# Enquanto estiver no Netlify, use a URL HTTPS real do site.
ALLOWED_ORIGINS=https://seu-site.netlify.app
FRONTEND_URL=https://seu-site.netlify.app
